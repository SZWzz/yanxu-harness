# Build and test artifacts of the package itself. The host repository's own
# .gitignore does not cover this directory, and an editable install drops an
# egg-info directory here.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
# Throwaway virtualenvs used to exercise the optional extras (MCP, Python
# floors) without touching the project venv `pytest` runs in.
.venv-*/

# OS junk: an editor or Finder drops these into the tree and setuptools
# happily packages a file it finds inside a package directory.
.DS_Store
**/.DS_Store

# The local dependency cache the offline CI gate prepares next to the tree
# (`python scripts/ci_check.py --prepare-wheelhouse build-wheelhouse`). It holds
# platform-specific wheels and must never reach a git archive or an sdist.
/build-wheelhouse/

# Coding-agent session state (goals, transcripts). Machine-local, not a deliverable.
.pi/
