# Source distribution contents. The wheel is built from the package directory
# itself; these extra files make the sdist reviewable without the host repo.
include README.md
include README.zh-CN.md
include LICENSE
include THIRD_PARTY_NOTICES.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include SUPPORT.md
recursive-include LICENSES *
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py

# Never ship these.
exclude .github
prune .github
global-exclude __pycache__/*.pyc
global-exclude .DS_Store
